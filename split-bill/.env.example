POSTGRES_PASSWORD=postgres
POSTGRES_DB=splitbill

# ============================================
# NEXTAUTH
# ============================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-min-32-characters"
NEXTAUTH_URL="http://localhost:3000"

